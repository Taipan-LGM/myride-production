# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins (for phone testing on LAN)
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.2.111:3000
# Optional: extra origins (e.g. custom domain + Render URL during migration)
# EXTRA_APP_ORIGINS=https://www.example.com,https://example.com

# Production only: set HELMET_DISABLE_CSP=1 if Content-Security-Policy breaks something and you need a hotfix.
# HELMET_DISABLE_CSP=0

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin auto-bootstrap (optional; if set, server creates this admin on boot if missing)
ADMIN_EMAIL=admin@myride.local
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=My Ride Admin

# Geocoding / address search
# auto | google | nominatim — "auto" uses Google when GOOGLE_PLACES_API_KEY is set, else OSM Nominatim
GEOCODE_PROVIDER=auto
# Reverse (pickup “current location” label): auto | google | nominatim — "auto" uses Google Geocoding when key is set (enable Geocoding API on the key), else OSM with building-level zoom
GEOCODE_REVERSE_PROVIDER=auto
# Google Places API (New): enable Places API in Google Cloud; restrict key by HTTP referrer / IP
GOOGLE_PLACES_API_KEY=
# Optional map bias when city geocode is unknown (decimal degrees)
# APP_CENTER_LAT=
# APP_CENTER_LNG=
GOOGLE_LOCATION_BIAS_RADIUS_M=50000
# Always merge OpenStreetMap with Google Places for address suggest (fuller list; slower). Ignores SKIP_OS_THRESHOLD below.
# GEOCODE_GOOGLE_SUGGEST_ALWAYS_MERGE_OSM=true
# Skip OSM when Google returns at least this many predictions (faster). Ignored when ALWAYS_MERGE_OSM=true. Default 4; use 0 so Google-only shortcut never runs.
# GEOCODE_GOOGLE_SUGGEST_SKIP_OS_THRESHOLD=4
# Places Autocomplete (New): comma-separated primary types, max 5. Stricter: street_address | default: premise,street_address,subpremise
# GOOGLE_AUTOCOMPLETE_PRIMARY_TYPES=street_address
# Restrict autocomplete to admin/request country (default admin_country). Omitting regions returns global suggestions — avoid that when Admin “ZA only” is on.
# GOOGLE_AUTOCOMPLETE_REGION_RESTRICTION=admin_country
# GOOGLE_AUTOCOMPLETE_REGION_RESTRICTION=none
# Minimum delay between outbound Nominatim requests (OSM fair-use policy, milliseconds)
NOMINATIM_MIN_INTERVAL_MS=1100
# Local dev only: when browser hits localhost, “Approximate (IP)” cannot GeoIP you — these coords are used if set (decimal degrees)
# DEV_GEO_FALLBACK_LAT=-33.9249
# DEV_GEO_FALLBACK_LNG=18.4241

# Fare distance (server-side estimate matches Live Tracking when OSRM is used)
# Optional: self-hosted or regional OSRM instance (default: https://router.project-osrm.org)
# OSRM_BASE_URL=https://router.project-osrm.org
# CartTrack: admin sets full HTTPS endpoint URL in Settings; secret stays in env
# CARTTRACK_API_KEY=

# Database
SQLITE_PATH=./mycab.sqlite

# Staff QR login (operators, supervisors, managers — separate from driver Logicline QR)
# In development, staff challenges auto-confirm unless STAFF_QR_AUTO_CONFIRM=0
# STAFF_QR_AUTO_CONFIRM=1

# Driver / Logicline (Option B QR login)
# Optional: override the server-side regex for external driver ids (default matches ll-...)
# LOGICLINE_EXTERNAL_ID_REGEX=^ll-[a-z0-9][a-z0-9-]{2,63}$

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Production: allow POST /api/payments/mock-pay when keys are still placeholders (optional).
# ALLOW_MOCK_PAYMENTS=1
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional: Stripe Connect destination charge (platform keeps application_fee_amount as owner commission).
# STRIPE_USE_CONNECT_DESTINATION=1
# STRIPE_DESTINATION_ACCOUNT_ID=acct_...

# Zoneless (self-hosted) — USDC payouts to drivers after Stripe is paid
# Install SDK when using payouts: npm install @zoneless/node
ZONELESS_API_KEY=
ZONELESS_BASE_URL=http://localhost:8787
ZONELESS_WEBHOOK_SECRET=

# Stripe Checkout URLs (frontend routes)
STRIPE_SUCCESS_URL=http://localhost:3000/#/customer?paid=1
STRIPE_CANCEL_URL=http://localhost:3000/#/customer?paid=0

# Production: using sk_test_... logs a warning unless you acknowledge demo deploy:
# STRIPE_ALLOW_TEST_KEYS_IN_PRODUCTION=1

# After going live, rotate keys in Stripe Dashboard and update STRIPE_SECRET_KEY + webhook signing secret.
# Keep test keys in a separate Render environment or branch preview.

