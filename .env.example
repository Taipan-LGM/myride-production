# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins (for phone testing on LAN)
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.2.111:3000

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin auto-bootstrap (optional; if set, server creates this admin on boot if missing)
ADMIN_EMAIL=admin@myride.local
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=My Ride Admin

# Database
SQLITE_PATH=./mycab.sqlite

# Driver / Logicline (Option B QR login)
# Optional: override the server-side regex for external driver ids (default matches ll-...)
# LOGICLINE_EXTERNAL_ID_REGEX=^ll-[a-z0-9][a-z0-9-]{2,63}$

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe Checkout URLs (frontend routes)
STRIPE_SUCCESS_URL=http://localhost:3000/#/customer?paid=1
STRIPE_CANCEL_URL=http://localhost:3000/#/customer?paid=0

