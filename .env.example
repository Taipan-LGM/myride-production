ENVIRONMENT=development
PORT=8000
MYRIDE_DATABASE_PATH=./data/myride.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MYRIDE_AUTH_SECRET=replace-with-at-least-32-random-characters
MYRIDE_PASSENGER_PASSWORD=replace-me
MYRIDE_DRIVER_PASSWORD=replace-me
MYRIDE_ADMIN_PASSWORD=replace-me
MYRIDE_RATE_LIMIT=120
MYRIDE_AUTH_RATE_LIMIT=10

# Optional production integrations. The local ecosystem runs without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=zar
LLM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=