# =============================================================================
# My Ride Flutter — Environment Variables (copy to .env)
# =============================================================================
# Find your LAN IP:  hostname -I | awk '{print $1}'
# Physical devices must use LAN IP; localhost only works on the dev machine.
# =============================================================================

# --- API ---
# Web/emulator on same PC:
# API_BASE_URL=http://localhost:8000
# WEBSOCKET_BASE_URL=ws://localhost:8000
#
# Physical Android/iOS on same Wi‑Fi (replace with your IP):
API_BASE_URL=http://192.168.0.34:8000
WEBSOCKET_BASE_URL=ws://192.168.0.34:8000

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=YOUR_ANDROID_KEY
GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_KEY
GOOGLE_MAPS_API_KEY_WEB=YOUR_WEB_KEY

# --- Stripe (test mode) ---
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Firebase (optional — mock auth when placeholders) ---
FIREBASE_WEB_API_KEY=...
FIREBASE_AUTH_DOMAIN=...
FIREBASE_PROJECT_ID=...
FIREBASE_STORAGE_BUCKET=...
FIREBASE_MESSAGING_SENDER_ID=...
FIREBASE_APP_ID=...
