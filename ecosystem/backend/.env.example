# =============================================================================
# My Ride Backend — Environment Variables
# =============================================================================
# Setup:
#   cp .env.example .env
#   ./start_api.sh
#
# Docker:
#   docker compose up --build
# =============================================================================

# --- Core API ---
APP_NAME=My Ride API
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# --- OpenAI (natural-language trip parsing) ---
# Leave empty to use built-in heuristic parser in dev.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Twilio (voice IVR + WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Shown on /channels when Twilio numbers unset
PUBLIC_BOOKING_PHONE=+278000MYRIDE
PUBLIC_WHATSAPP_NUMBER=whatsapp:+278000MYRIDE

# --- Stripe (hybrid: test by default, live when ENVIRONMENT=production) ---
ENVIRONMENT=development
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=zar
# Optional; defaults to PUBLIC_BASE_URL with a Stripe Connect query marker.
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
STRIPE_CONNECT_COUNTRY=ZA
# Set true only after Stripe confirms Connect support for the South African platform account.
STRIPE_CONNECT_ZA_APPROVED=false

# --- Google Firestore ---
# Leave FIRESTORE_PROJECT_ID empty for in-memory dev database.
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
USE_FIRESTORE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Redis (driver location cache; started by docker-compose) ---
REDIS_URL=redis://localhost:6379/0

# --- Cartrack (server-side Admin fleet telemetry) ---
CARTRACK_ENABLED=false
CARTRACK_BASE_URL=https://fleetapi-za.cartrack.com/rest
CARTRACK_USERNAME=
CARTRACK_API_KEY=

# --- Driver remuneration (basis points; 8500 = 85%) ---
DEFAULT_DRIVER_SHARE_BPS=8500

# --- Driver proximity search defaults ---
DRIVER_SEARCH_RADIUS_KM=5.0
DRIVER_SEARCH_LIMIT=10

# --- Auth ---
JWT_SECRET=my-ride-sa-dev-secret-change-me

# --- Postgres ---
# docker compose up postgres → then:
DATABASE_URL=postgresql://myride:myride@localhost:5432/myride
# Dual-write (default): mirror trips into ride_events while memory/Firestore stays hot.
# Part 11 primary: trips read/write ride_events as source of truth.
# USE_POSTGRES_PRIMARY=true

# --- Production checklist ---
# ENVIRONMENT=production
# DEBUG=false
# JWT_SECRET=<long random secret>
# CORS_ORIGINS=https://your-domain.example
# STRIPE_LIVE_SECRET_KEY=sk_live_...
# DATABASE_URL=postgresql://...

# --- Ngrok (expose webhooks: docker compose --profile tunnel up) ---
NGROK_AUTHTOKEN=

# --- Admin OTP server (separate process on port 8788) ---
#   python3 admin_otp_server.py
OTP_HOST=127.0.0.1
OTP_PORT=8788
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="My Ride Admin <noreply@myride.com>"
RESEND_API_KEY=
RESEND_FROM=My Ride Admin <onboarding@resend.dev>
DEV_OTP_CONSOLE=true
OTP_TTL_SECONDS=600
