# Copy to .env.prod and fill secrets. Never commit .env.prod.
# Usage:
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
API_PORT=8000

# Must be https for Twilio signature validation
PUBLIC_BASE_URL=https://api.yourdomain.co.za
CORS_ORIGINS=https://app.yourdomain.co.za,https://yourdomain.co.za

JWT_SECRET=replace-with-long-random-secret-min-32-chars

POSTGRES_DB=myride
POSTGRES_USER=myride
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://myride:replace-with-strong-db-password@postgres:5432/myride
USE_POSTGRES_PRIMARY=true

STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=zar

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+27...

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
