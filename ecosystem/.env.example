# My Ride Ecosystem - Environment Configuration
# Copy this file to .env and configure for your environment

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_BASE_URL=http://localhost:8001

# Debug Mode (set to false in production)
DEBUG=true

# CORS Origins (comma-separated, use * for development)
CORS_ORIGINS=http://localhost:8001,http://localhost:3000,http://localhost:8766,http://localhost:8767

# Frontend Configuration
FLUTTER_RIDER_PORT=8766
FLUTTER_DRIVER_PORT=8767

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION_HOURS=168

# Database (optional - uses in-memory SQLite if not set)
# DATABASE_URL=postgresql://user:pass@localhost:5432/myride

# Redis (optional - required for real-time features)
# REDIS_URL=redis://localhost:6379/0